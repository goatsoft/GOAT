# Copy to .env.local for personal overrides (git-ignored). The tracked .env holds the
# public defaults; CI sets VITE_REPO and VITE_BASE from the GitHub context.

# GitHub "owner/repo". Every repo link on the site (releases, wiki, issues, docs) derives from it.
VITE_REPO=OWNER/REPO

# Deploy base path. "/" for local dev or a custom domain, "/<repo>/" for a GitHub project site.
VITE_BASE=/

# Where the "oMLX" links go.
VITE_OMLX_URL=https://omlx.ai

# Set to 1 to build a hash-routed bundle for single-file previews. Leave unset normally.
# VITE_HASH_ROUTER=1

# Absolute URL of the landing page, used by the docs site's Website link (CI sets it).
# VITE_SITE_URL=http://localhost:4173/
