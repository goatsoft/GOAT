{
  "name": "goat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "node scripts/dev-https.mjs",
    "build": "vite build && vue-tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "dev:all": "VITE_SITE_URL=http://localhost:5173/ vitepress dev docs --port 5174 --strictPort & vite --port 5173 --strictPort; kill $!",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:all": "npm run build && npm run docs:build && rm -rf dist/docs && cp -R docs/.vitepress/dist dist/docs",
    "check:content": "node scripts/check-built-links.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.4.1",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "^1.2.34",
    "@iconify-json/simple-icons": "^1.2.94",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@webgpu/types": "^0.1.72",
    "markdown-it": "^14.3.1",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.20",
    "vue-tsc": "^3.3.11"
  }
}
